# Example lab configuration. Replace all values for your own setup.
GOIP_HOST=0.0.0.0
GOIP_PORT=56012

# GoIP-side account. line_id = GOIP_SMB_ID * 100 + slot.
GOIP_SMB_ID=1001
GOIP_SMB_KEY=lab-smb-key

# SIMBank-side scheduler account used for server-to-gateway MACs.
GOIP_SCHE_SMB_ID=200
GOIP_SCHE_SMB_KEY=lab-sche-key

# One physical PC/SC reader per exported GoIP slot.
GOIP_READER_MAP=1=0

GOIP_SIGN_BLOBS=1
GOIP_STRICT_AUTH=0
# Original ATR delay is 7.5 sec
GOIP_ATR_DELAY=6
LOG_LEVEL=INFO
